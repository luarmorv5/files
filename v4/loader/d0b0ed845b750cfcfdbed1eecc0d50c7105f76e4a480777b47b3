        Size = UDim2.fromOffset(12, 12),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        BackgroundTransparency = 1,
        Image = iconId,
        ImageColor3 = THEME.TextMuted,
        ScaleType = Enum.ScaleType.Fit,
        Parent = b,
    })
    b.MouseEnter:Connect(function()
        tween(b, TWEEN_FAST, {BackgroundTransparency = 0})
        tween(ic, TWEEN_FAST, {ImageColor3 = hoverColor or THEME.TextPrimary})
    end)
    b.MouseLeave:Connect(function()
        tween(b, TWEEN_FAST, {BackgroundTransparency = 1})
        tween(ic, TWEEN_FAST, {ImageColor3 = THEME.TextMuted})
    end)
    return b
end

