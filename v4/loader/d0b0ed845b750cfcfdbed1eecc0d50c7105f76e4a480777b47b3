local function minimize()
    if isMinimized or isAnimating then return end
    isAnimating, isMinimized = true, true
    savedPosition = Main.Position
    local target = MiniHolder.Position
    tween(Main, MIN_IN, {Position = target})
    tween(MainScale, MIN_IN, {Scale = 0.05})
    tween(Window, MIN_IN, {GroupTransparency = 1})
    tween(Glow, MIN_IN, {ImageTransparency = 1})
    tween(OutlineStroke, MIN_IN, {Transparency = 1})
    task.delay(MIN_IN.Time, function()
        if not ScreenGui.Parent then return end
        Main.Visible = false
        MiniHolder.Visible = true
        MiniScale.Scale = 0
        tween(MiniScale, POP_OUT, {Scale = 1})
        task.delay(POP_OUT.Time, function() isAnimating = false end)
    end)
end

local function restore()
    if not isMinimized or isAnimating then return end
    isAnimating = true
    tween(MiniScale, POP_IN, {Scale = 0})
    task.delay(POP_IN.Time, function()
        if not ScreenGui.Parent then return end
        MiniHolder.Visible = false
        Main.Position = MiniHolder.Position
        MainScale.Scale = 0.05
        Main.Visible = true
        tween(Main, RESTORE_POS, {Position = savedPosition})
        tween(MainScale, RESTORE_SCL, {Scale = 1})
        tween(Window, RESTORE_POS, {GroupTransparency = 0})
        tween(Glow, RESTORE_POS, {ImageTransparency = 0.82})
        tween(OutlineStroke, RESTORE_POS, {Transparency = 0})
        task.delay(RESTORE_SCL.Time, function()
            isAnimating, isMinimized = false, false
        end)
    end)
end

local function toggleMinimize()
    if isMinimized then restore() else minimize() end
end

MinimizeBtn.MouseButton1Click:Connect(minimize)

-- Drag + click floating toggle
do
    local pressing, moved, startInput, startPos = false, false, nil, nil
    MiniButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            pressing, moved = true, false
            startInput, startPos = input.Position, MiniHolder.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if pressing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - startInput
            if d.Magnitude > 4 then moved = true end
            if moved then
                MiniHolder.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if pressing and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            pressing = false
            if not moved then restore() end
        end
    end)
    MiniButton.MouseEnter:Connect(function()
        if isMinimized and not isAnimating then tween(MiniScale, TWEEN_FAST, {Scale = 1.08}) end
    end)
    MiniButton.MouseLeave:Connect(function()
        if isMinimized and not isAnimating then tween(MiniScale, TWEEN_FAST, {Scale = 1}) end
    end)
end

